{
  "name": "jobtrack-server",
  "version": "1.0.0",
  "description": "JobTrack Backend REST API - Node.js, Express & MongoDB",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
